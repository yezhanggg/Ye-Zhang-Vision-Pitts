# Copy to .env and fill in. .env is git-ignored; never commit keys.

# US Census Bureau API key (free): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Claude API key for the explanation layer (app/api), used when DEEPSEEK_API_KEY is empty. Never used to compute a score.
ANTHROPIC_API_KEY=

# Supabase (Explore data browser: county-wide rows and, later, saved scenarios).
# Server / pipeline side only. The secret key and the access token must never reach the browser or Vercel.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Browser side. VITE_ variables are compiled into the public bundle, so ONLY the publishable (anon) key goes here.
# Row-level security on the Supabase tables is what keeps the data read-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# DeepSeek key for the explanation sentence in Analysis (server-side only; set it on Vercel too)
DEEPSEEK_API_KEY=

# HUD User API token (free): https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_API_KEY=
